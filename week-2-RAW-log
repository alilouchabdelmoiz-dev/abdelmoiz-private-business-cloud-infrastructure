    image: 'mariadb:10.11'
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: '[REDACTED_DB_PASSWORD]'
      MYSQL_DATABASE: 'npm'
      MYSQL_USER: 'npm'
      MYSQL_PASSWORD: '[REDACTED_DB_PASSWORD]'
      TZ: "Africa/Casablanca"
    volumes:
      - ./mysql:/var/lib/mysql

